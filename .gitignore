# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# app data (SQLite DB + uploaded page images)
/data/

# prisma generated client (regenerated via `npx prisma generate`)
/src/generated/

/src/generated/prisma

# Serwistがビルド時に生成するService Workerバンドル(ソースはsrc/app/sw.ts、`npm run build`で再生成される)
/public/sw.js
/public/sw.js.map

# 作業中のスクリーンショット・生成画像(プロジェクトのソースではないためリポジトリ直下のもののみ除外)
/*.png
/*.jpg
/*.jpeg
