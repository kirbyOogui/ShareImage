# Supabaseダッシュボード > Project Settings > Database から取得する接続文字列。
# DATABASE_URL: Transaction pooler(6543番ポート)。末尾に ?pgbouncer=true を付ける。
#   アプリの実行時クエリはすべてこちらを使う(サーバーレスの同時実行に対応するため)。
# DIRECT_URL: Direct connection(5432番ポート)。`prisma migrate` 等CLI操作専用。
#   pgbouncerのトランザクションプーリングはprepared statementと相性が悪いため分けている。
DATABASE_URL="postgresql://postgres.xxxxx:[PASSWORD]@aws-0-xxxxx.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:[PASSWORD]@aws-0-xxxxx.pooler.supabase.com:5432/postgres"

# ストレージドライバ: local | s3 (本番はSupabase StorageのS3互換APIを使うため s3 に設定する)
STORAGE_DRIVER="local"
UPLOAD_DIR="./data/uploads"

# S3互換ストレージ (STORAGE_DRIVER=s3 のときのみ使用)。
# Supabaseダッシュボード > Storage > 設定(歯車アイコン) > S3 Connection から取得する。
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Vercel Cron Jobsから期限切れ共有クリーンアップAPI(/api/cron/cleanup-expired)を呼ぶ際の
# 認証用シークレット。Vercelダッシュボードでこのプロジェクトに環境変数として設定すると、
# Vercelが自動でcron呼び出し時のAuthorizationヘッダーに付与してくれる(生成方法は
# `openssl rand -hex 32` 等でOK。ローカル開発では未使用)。
CRON_SECRET=""

# 管理者ログイン (パスワードの平文は保存しない。scripts/hash-password.ts でハッシュ化して設定する)
# 注意: bcryptハッシュは "$2b$12$..." のように$を含むため、Next.jsのdotenv-expandによる変数展開を防ぐために
# 必ず $ を \$ にエスケープしてから貼り付けること(例: \$2b\$12\$...)。
ADMIN_PASSWORD_HASH=""

# 管理者ログイン画面のURL(/admin/loginのような推測可能な固定パスではなく、
# このランダムな値を知っている人だけがログイン画面(/a/{この値})にたどり着けるようにする。
# scripts/generate-admin-login-path.ts で生成する。
ADMIN_LOGIN_PATH=""

# 閲覧者向け一覧ページ(全共有をグリッド表示するギャラリー)のURL(/collection/{この値})。
# scripts/generate-gallery-path.ts で生成する。
GALLERY_PATH=""

# Cookie署名・IPハッシュ化に使う秘密鍵 (例: `openssl rand -hex 32` で生成)
SESSION_SECRET=""

# CSRF対策のOriginチェックに使用する自サイトのオリジン
NEXT_PUBLIC_APP_ORIGIN="http://localhost:3000"

# Web Push (VAPID) — scripts/generate-vapid-keys.ts で生成
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT_EMAIL="admin@example.com"

# PDF編集画面のAIインペインティング(消しゴム機能)で使用。ReplicateのAPIトークン
# (https://replicate.com/account/api-tokens で発行)。LaMaモデル(allenhooo/lama)を呼び出す。
REPLICATE_API_TOKEN=""
# 省略可。差し替えたいモデルがあれば "owner/model-name" 形式で指定(既定値: allenhooo/lama)。
REPLICATE_LAMA_MODEL=""
